<Window x:Class="MacTune.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:MacTune.Controls"
        Title="MacTune" Height="760" Width="1140" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Icon="app.ico"
        Background="{StaticResource Bg}" FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13.5"
        TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Sidebar ============ -->
        <Border Background="{StaticResource Side}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <DockPanel Margin="12,18,12,14">
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,14">
                    <Border Width="34" Height="34" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A84FF" Offset="0"/>
                                <GradientStop Color="#0055D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="MacTune" FontSize="16.5" FontWeight="Bold"/>
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="6" Padding="5,1" Margin="6,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="SideVersion" Text="v1.0" Foreground="{StaticResource Accent}" FontSize="10.5" FontWeight="SemiBold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Control Center" Style="{StaticResource Muted}" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Footer: Settings + Compact status -->
                <StackPanel DockPanel.Dock="Bottom">
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE713;" Content="Cài đặt" Checked="Nav_Checked" x:Name="NavSettings" Margin="0,0,0,8"/>
                    <Border Background="#F6F9FE" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="13" Padding="12,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Green}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="SideProfile" Text="–" FontWeight="SemiBold" FontSize="12.5"/>
                            </DockPanel>
                            <TextBlock x:Name="SideTemp" Text="CPU –" Style="{StaticResource Muted}" FontSize="11.5"/>
                            <TextBlock x:Name="SideBattery" Text="Pin –" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,1,0,0"/>
                            <TextBlock x:Name="SideFan" Text="" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,1,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Grouped Nav -->
                <StackPanel>
                    <TextBlock Text="ĐIỀU KHIỂN" Style="{StaticResource SectionCap}" Margin="12,2,0,4"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE80F;" Content="Tổng quan" IsChecked="True" Checked="Nav_Checked" x:Name="NavOverview"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE9D9;" Content="Quạt &amp; Nhiệt" Checked="Nav_Checked" x:Name="NavFans"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE945;" Content="Hiệu năng" Checked="Nav_Checked" x:Name="NavPerf"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE83F;" Content="Pin" Checked="Nav_Checked" x:Name="NavBattery"/>

                    <TextBlock Text="TIỆN ÍCH" Style="{StaticResource SectionCap}"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE916;" Content="Tự động hóa" Checked="Nav_Checked" x:Name="NavAuto"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xEDA2;" Content="Đĩa &amp; Dọn dẹp" Checked="Nav_Checked" x:Name="NavClean"/>
                    <RadioButton Style="{StaticResource Nav}" Tag="&#xE7F4;" Content="Hệ thống" Checked="Nav_Checked" x:Name="NavSystem"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="22,20,22,24">

                <!-- ===== Overview (Control Center) ===== -->
                <StackPanel x:Name="PageOverview">
                    <!-- Compact Header + Status Pill -->
                    <DockPanel Margin="6,0,6,10">
                        <Border x:Name="HealthBanner" DockPanel.Dock="Right" VerticalAlignment="Center"
                                Background="{StaticResource GreenSoft}" BorderBrush="#BCEBD7" BorderThickness="1"
                                CornerRadius="20" Padding="12,5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="HealthEmoji" Text="😊" FontSize="14" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock x:Name="HealthTitle" Text="Ổn định" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <StackPanel>
                            <TextBlock Style="{StaticResource PageTitle}" Text="Tổng quan" Margin="0"/>
                            <TextBlock x:Name="MachineInfo" Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Contextual Alert Strip (only visible when attention needed) -->
                    <Border x:Name="TipsCard" Visibility="Collapsed" Background="{StaticResource OrangeSoft}"
                            BorderBrush="#FCD9A4" BorderThickness="1" CornerRadius="12" Padding="14,9" Margin="5,0,5,6">
                        <ItemsControl x:Name="Tips">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#92400E" FontSize="12.5" FontWeight="Medium" TextWrapping="Wrap" Margin="0,1"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- 4 Metric Cards: CPU Temp, Power In, Power Used, Battery -->
                    <UniformGrid Columns="4">
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource OrangeSoft}" DockPanel.Dock="Right">
                                        <TextBlock Text="&#xE9CA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Orange}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Nhiệt CPU" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="OvTemp" Style="{StaticResource Metric}" Text="–" Margin="0,5,0,7"/>
                                <ProgressBar x:Name="OvTempBar" Maximum="100" Foreground="{StaticResource Orange}"/>
                                <TextBlock x:Name="OvClock" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" Text="Xung nhịp –"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource GreenSoft}" DockPanel.Dock="Right">
                                        <TextBlock Text="&#xE83E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Đang sạc vào" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="OvChargeIn" Style="{StaticResource Metric}" Text="–" Margin="0,5,0,7"/>
                                <ProgressBar x:Name="OvChargeInBar" Maximum="100" Foreground="{StaticResource Green}"/>
                                <TextBlock x:Name="OvChargeInSub" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" Text="Nguồn sạc –" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource AccentSoft}" DockPanel.Dock="Right">
                                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Đang sử dụng" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="OvPower" Style="{StaticResource Metric}" Text="–" Margin="0,5,0,7"/>
                                <ProgressBar x:Name="OvPowerBar" Maximum="100" Foreground="{StaticResource Accent}"/>
                                <TextBlock x:Name="OvPowerSub" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" Text="CPU – · GPU –" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel>
                                    <Border Width="26" Height="26" CornerRadius="8" Background="{StaticResource GreenSoft}" DockPanel.Dock="Right">
                                        <TextBlock Text="&#xE83F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13"
                                                   Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="Mức pin" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock x:Name="OvBattery" Style="{StaticResource Metric}" Text="–" Margin="0,5,0,7"/>
                                <ProgressBar x:Name="OvBatteryBar" Maximum="100" Foreground="{StaticResource Green}"/>
                                <TextBlock x:Name="OvBatterySub" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,6,0,0" Text="Trạng thái –" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Discrete AMD GPU Live Card -->
                    <Border x:Name="GpuOverviewCard" Style="{StaticResource CardBox}" Visibility="Collapsed">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <StackPanel Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="Nhiệt" Style="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock x:Name="OvGpuTemp" Text="–" FontSize="16.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="Tải" Style="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock x:Name="OvGpuLoad" Text="–" FontSize="16.5" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="Điện" Style="{StaticResource Muted}" FontSize="11"/>
                                    <TextBlock x:Name="OvGpuPower" Text="–" FontSize="16.5" FontWeight="Bold" Foreground="{StaticResource Accent}"/>
                                </StackPanel>
                                <StackPanel Margin="14,0,0,0" Width="125" VerticalAlignment="Center">
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock x:Name="OvGpuVram" DockPanel.Dock="Right" FontSize="11.5" FontWeight="SemiBold"/>
                                        <TextBlock Text="VRAM" Style="{StaticResource Muted}" FontSize="11"/>
                                    </DockPanel>
                                    <ProgressBar x:Name="OvGpuVramBar" Maximum="100" Height="5.5" Foreground="#6366F1"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" CornerRadius="11" Background="#EEF2FF" Margin="0,0,12,0">
                                    <TextBlock Text="&#xE7F4;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="17"
                                               Foreground="#4F46E5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="OvGpuName" Text="AMD Radeon Pro" FontWeight="SemiBold" FontSize="14.5"/>
                                    <TextBlock x:Name="OvGpuApps" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,1.5,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Quick Profiles -->
                    <TextBlock Text="Chế độ" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" Margin="8,8,0,2"/>
                    <UniformGrid x:Name="OvProfiles" Columns="3"/>

                    <!-- Control Center Sliders: Brightness + Keyboard Backlight -->
                    <Grid Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SlBright, StringFormat={}{0:0}%}"
                                               Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="{StaticResource Orange}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Màn hình" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <Slider x:Name="SlBright" Minimum="0" Maximum="100" ValueChanged="SlBright_ValueChanged"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBox}">
                            <StackPanel VerticalAlignment="Center">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Right" x:Name="KbdLabel" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                                   Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="Đèn phím" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </DockPanel>
                                <Slider x:Name="SlKbd" Minimum="0" Maximum="100" ValueChanged="SlKbd_ValueChanged"/>
                                <TextBlock x:Name="KbdStatus" Style="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" Visibility="Collapsed"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Control Center Quick Switches: Meeting + Mac Keys + Touch Bar -->
                    <UniformGrid Columns="3">
                        <Border Style="{StaticResource CardBox}" Padding="14,11">
                            <CheckBox x:Name="ChkMeeting" Style="{StaticResource Switch}" Click="Meeting_Click" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="🎤  Chế độ Họp" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="MeetingDesc" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Text="Giữ sáng · quạt êm"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Padding="14,11">
                            <CheckBox x:Name="ChkOvMacKeys" Style="{StaticResource Switch}" Click="OvMacKeys_Click" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="⌘  Phím kiểu Mac" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OvMacKeysDesc" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Text="Đảo Command ↔ Ctrl"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource CardBox}" Padding="14,11">
                            <CheckBox x:Name="ChkOvTbFn" Style="{StaticResource Switch}" Click="OvTbFn_Click" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="🎛  Touch Bar F1–F12" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="OvTbFnDesc" Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Text="Hiện F1–F12"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>
                    </UniformGrid>

                    <!-- Telemetry Charts -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="ChartTempNow" DockPanel.Dock="Right" Foreground="{StaticResource Orange}" FontWeight="Bold"/>
                                    <TextBlock Text="Nhiệt độ (3 phút)" FontWeight="SemiBold" FontSize="13.5"/>
                                </DockPanel>
                                <c:LineChart x:Name="ChartTemp" Height="128" FixedMax="100" Unit="°C" Stroke="#F59E0B"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="ChartPowerNow" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="Bold"/>
                                    <TextBlock Text="Đang sử dụng (3 phút)" FontWeight="SemiBold" FontSize="13.5"/>
                                </DockPanel>
                                <c:LineChart x:Name="ChartPower" Height="128" Unit="W" Stroke="#0071E3"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock x:Name="SensorWarning" Style="{StaticResource Muted}" Foreground="{StaticResource Orange}" Margin="8,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>

                <!-- ===== Performance ===== -->
                <StackPanel x:Name="PagePerf" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Hiệu năng"/>

                    <UniformGrid x:Name="PerfProfiles" Columns="3"/>

                    <Border Style="{StaticResource CardBox}" Margin="5,10,5,5">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <Border DockPanel.Dock="Right" Background="{StaticResource Bg}" CornerRadius="10" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="PowerAc" Style="{StaticResource Seg}" GroupName="src" Content="🔌 Cắm sạc" IsChecked="True" Checked="PowerSource_Checked"/>
                                        <RadioButton x:Name="PowerDc" Style="{StaticResource Seg}" GroupName="src" Content="🔋 Chạy pin" Checked="PowerSource_Checked"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Tinh chỉnh CPU" VerticalAlignment="Center" Margin="0"/>
                            </DockPanel>

                            <TextBlock Text="Turbo Boost" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,4,0,6"/>
                            <Border Background="{StaticResource Bg}" CornerRadius="10" Padding="2" HorizontalAlignment="Left">
                                <StackPanel x:Name="BoostSeg" Orientation="Horizontal"/>
                            </Border>

                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SlMax, StringFormat={}{0:0}%}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Xung tối đa" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Slider x:Name="SlMax" Minimum="20" Maximum="100"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SlMin, StringFormat={}{0:0}%}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Xung tối thiểu" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Slider x:Name="SlMin" Minimum="0" Maximum="100"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" x:Name="EppLabel" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Ưu tiên năng lượng (EPP)" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Slider x:Name="SlEpp" Minimum="0" Maximum="100" ValueChanged="SlEpp_ValueChanged"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=SlCores, StringFormat={}{0:0}%}" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        <TextBlock Text="Nhân hoạt động" FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <Slider x:Name="SlCores" Minimum="0" Maximum="100"/>
                                </StackPanel>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                <Button Style="{StaticResource Primary}" Content="Áp dụng" Click="ApplyAdvanced_Click"/>
                                <Button Content="Mặc định" Click="ResetAdvanced_Click"/>
                                <TextBlock x:Name="PerfStatus" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Battery ===== -->
                <StackPanel x:Name="PageBattery" Visibility="Collapsed">
                    <DockPanel Margin="6,0,6,10">
                        <TextBlock x:Name="BatState" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Style="{StaticResource PageTitle}" Text="Pin" Margin="0"/>
                    </DockPanel>

                    <UniformGrid Columns="5">
                        <Border Style="{StaticResource CardBox}"><StackPanel>
                            <TextBlock Text="Mức pin" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="BatLevel" FontSize="23" FontWeight="Bold" Text="–" Margin="0,6,0,2"/>
                            <TextBlock Style="{StaticResource Muted}" FontSize="11.5"><Run Text="Độ khỏe "/><Run x:Name="BatHealth" Text="–" FontWeight="SemiBold"/></TextBlock>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardBox}"><StackPanel>
                            <TextBlock Text="🔌 Sạc vào" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="BatPowerIn" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Green}" Text="–" Margin="0,6,0,2"/>
                            <TextBlock x:Name="BatPowerInSub" Style="{StaticResource Muted}" FontSize="11.5" Text="–"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardBox}"><StackPanel>
                            <TextBlock Text="⚡ Đang sử dụng" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="BatPowerOut" FontSize="23" FontWeight="Bold" Foreground="{StaticResource Accent}" Text="–" Margin="0,6,0,2"/>
                            <TextBlock Text="Toàn hệ thống" Style="{StaticResource Muted}" FontSize="11.5"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardBox}"><StackPanel>
                            <TextBlock Text="🔋 Vào / Ra pin" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="BatRate" FontSize="23" FontWeight="Bold" Text="–" Margin="0,6,0,2"/>
                            <TextBlock x:Name="BatRateSub" Style="{StaticResource Muted}" FontSize="11.5" Text="–"/>
                        </StackPanel></Border>
                        <Border Style="{StaticResource CardBox}"><StackPanel>
                            <TextBlock Text="Còn lại" Style="{StaticResource Muted}"/>
                            <TextBlock x:Name="BatTime" FontSize="23" FontWeight="Bold" Text="–" Margin="0,6,0,2"/>
                            <TextBlock Text="Ước tính" Style="{StaticResource Muted}" FontSize="11.5"/>
                        </StackPanel></Border>
                    </UniformGrid>

                    <!-- Charge Limit prominent card -->
                    <Border Style="{StaticResource CardBox}">
                        <CheckBox x:Name="ChkChargeLimit" Style="{StaticResource Switch}" Click="ChkChargeLimit_Click">
                            <StackPanel>
                                <TextBlock Text="🔋  Giới hạn sạc 80%" FontSize="14.5" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ChargeLimitStatus" Style="{StaticResource Muted}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <!-- Runtime estimate per profile -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Thời lượng ước tính"/>
                            <ItemsControl x:Name="BatEstimates">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="11" Padding="13,10" Margin="0,0,8,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}"/>
                                                <TextBlock Text="{Binding Hours}" FontSize="20" FontWeight="Bold" Margin="0,3,0,2"/>
                                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Công suất đang sử dụng (W)"/>
                                <c:LineChart x:Name="ChartBattery" Height="150" Unit="W" Stroke="#10B981"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Thông số"/>
                                <Grid x:Name="BatDetails">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                </Grid>
                                <Button Content="Báo cáo pin HTML" Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="BatteryReport_Click"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ===== Fans & thermals ===== -->
                <StackPanel x:Name="PageFans" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Quạt &amp; Nhiệt"/>

                    <!-- Fan gauges -->
                    <ItemsControl x:Name="FanGauges">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CardBox}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" CornerRadius="8" Padding="9,3" Background="{Binding BadgeBg}">
                                                <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Rpm}" Style="{StaticResource Metric}" Margin="0,6,0,8"/>
                                        <ProgressBar Value="{Binding Pct, Mode=OneWay}" Maximum="100" Foreground="{StaticResource Accent}"/>
                                        <TextBlock Text="{Binding Range}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Fan modes -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel x:Name="FanControls">
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock x:Name="FanStatus" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Chế độ quạt" Margin="0"/>
                            </DockPanel>
                            <UniformGrid x:Name="FanModeTiles" Columns="5" Margin="-5,0"/>

                            <StackPanel x:Name="FixedPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock DockPanel.Dock="Right" x:Name="FixedLabel" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                    <TextBlock Text="Tốc độ cố định" FontWeight="SemiBold"/>
                                </DockPanel>
                                <Slider x:Name="SlFan" Minimum="0" Maximum="100" ValueChanged="SlFan_ValueChanged"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="Cảm biến nhiệt"/>
                                <ItemsControl x:Name="TempList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4.5">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="185"/><ColumnDefinition/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                                                <ProgressBar Grid.Column="1" Value="{Binding Value, Mode=OneWay}" Maximum="105" VerticalAlignment="Center" Foreground="{Binding Brush}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Display}" TextAlignment="Right" FontWeight="SemiBold" FontSize="12.5"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock x:Name="ThrottleBadge" DockPanel.Dock="Right" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Accent}"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Hạ xung CPU" Margin="0"/>
                                </DockPanel>
                                <ItemsControl x:Name="ThrottleList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                                <DockPanel>
                                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Duration}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                                    <StackPanel>
                                                        <TextBlock FontSize="12.5"><Run Text="{Binding Time, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Reason, Mode=OneWay}" Foreground="{StaticResource Orange}"/></TextBlock>
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="ThrottleEmpty" Style="{StaticResource Muted}" Text="Không có hạ xung."/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>

                <!-- ===== System ===== -->
                <StackPanel x:Name="PageSystem" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Hệ thống"/>

                    <!-- Mac Keyboard & Touch Bar -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CardBox}">
                            <CheckBox x:Name="ChkSysMacKeys" ToolTip="⌘+C/V/Z · ⌘+Tab đổi app · ⌘+Q đóng app · ⌘+Shift+4 chụp màn hình" Style="{StaticResource Switch}" Click="SysMacKeys_Click" VerticalAlignment="Center">
                                <StackPanel>
                                    <TextBlock Text="⌘  Đảo phím kiểu Mac (Command ↔ Ctrl)" FontSize="14.5" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Muted}" FontSize="11.5" Margin="0,2,0,0" Text="⌘+Tab đổi app · ⌘+Q · ⌘+Shift+4 chụp màn hình"/>
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBox}">
                            <DockPanel VerticalAlignment="Center">
                                <Border DockPanel.Dock="Right" Background="{StaticResource Bg}" CornerRadius="10" Padding="2" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RbTbMedia" ToolTip="Giữ phím fn để hiện hàng còn lại" Style="{StaticResource Seg}" GroupName="tbmode" Content="🎵 Media" Click="TbMode_Click"/>
                                        <RadioButton x:Name="RbTbFn" Style="{StaticResource Seg}" GroupName="tbmode" Content="⌨ F1–F12" Click="TbMode_Click"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="🎛  Thanh Touch Bar" FontSize="14.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Boot Camp Hardware Fixes (Audio anti-pop, Bluetooth/Wi-Fi stability, Natural mouse scroll, Boot to macOS) -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,10">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="BtnBootMacOs" Content="🍎 Đĩa khởi động macOS" Padding="11,5" FontSize="12" Margin="0,0,8,0" Visibility="Collapsed" Click="BootMacOs_Click"/>
                                    <Button x:Name="BtnBcFixAll" Style="{StaticResource Primary}" Content="⚡ Tối ưu loa &amp; kết nối" Padding="12,5" FontSize="12" Margin="0" Click="BcFixAll_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="🛠  Sửa lỗi kinh điển Boot Camp" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>

                            <UniformGrid Columns="3" Margin="-4,0">
                                <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="4,0">
                                    <CheckBox x:Name="ChkFixAudioPop" ToolTip="Giữ mạch loa thức, không kêu bụp hoặc nuốt 0,5s âm đầu" Style="{StaticResource Switch}" Click="BcFixToggle_Click" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="🔊 Chống bụp &amp; trễ loa" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="4,0">
                                    <CheckBox x:Name="ChkFixWireless" ToolTip="Chống khựng chuột/tai nghe Bluetooth &amp; giảm giật ping Wi-Fi" Style="{StaticResource Switch}" Click="BcFixToggle_Click" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="🎧 Ổn định BT &amp; Wi-Fi" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="4,0">
                                    <CheckBox x:Name="ChkNaturalMouse" ToolTip="Đảo chiều lăn chuột USB/Bluetooth giống hệt macOS" Style="{StaticResource Switch}" Click="BcFixToggle_Click" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="🖱 Cuộn chuột tự nhiên" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </UniformGrid>

                            <TextBlock x:Name="BcFixStatus" Style="{StaticResource Muted}" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- 2-column Power & Lid timers -->
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="⏱  Màn hình &amp; Ngủ"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="🔌 Cắm sạc" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Column="3" Text="🔋 Pin" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Text="Tắt màn hình" VerticalAlignment="Center" FontSize="13"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbScreenAc" Margin="0,4" SelectionChanged="Timers_Changed"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CbScreenDc" Margin="0,4" SelectionChanged="Timers_Changed"/>
                                    <TextBlock Grid.Row="2" Text="Ngủ sau" VerticalAlignment="Center" FontSize="13"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbSleepAc" Margin="0,4" SelectionChanged="Timers_Changed"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="CbSleepDc" Margin="0,4" SelectionChanged="Timers_Changed"/>
                                </Grid>
                                <TextBlock x:Name="TimersStatus" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Tối ưu ngủ" Padding="11,5" FontSize="12" Margin="0" Style="{StaticResource Primary}" Click="LidPreset_Click"/>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="💤  Gập máy &amp; Ngủ đông" Margin="0" VerticalAlignment="Center"/>
                                </DockPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="105"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <TextBlock Grid.Column="1" Text="🔌 Cắm sạc" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Column="3" Text="🔋 Pin" Style="{StaticResource Muted}" Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1" Text="Khi gập máy" VerticalAlignment="Center" FontSize="13"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbLidAc" Margin="0,4" SelectionChanged="Lid_Changed"/>
                                    <ComboBox Grid.Row="1" Grid.Column="3" x:Name="CbLidDc" Margin="0,4" SelectionChanged="Lid_Changed"/>
                                    <TextBlock Grid.Row="2" Text="Ngủ đông sau" VerticalAlignment="Center" FontSize="13"/>
                                    <ComboBox Grid.Row="2" Grid.Column="1" x:Name="CbHibAc" Margin="0,4" SelectionChanged="Lid_Changed"/>
                                    <ComboBox Grid.Row="2" Grid.Column="3" x:Name="CbHibDc" Margin="0,4" SelectionChanged="Lid_Changed"/>
                                </Grid>
                                <TextBlock x:Name="LidStatus" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- GPU per app -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="+ Chọn .exe" Padding="12,6" Margin="0" Click="AddGpu_Click"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="🖥  GPU theo ứng dụng" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="GpuList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Danger}" Content="Xóa" Tag="{Binding}" Margin="6,0,0,0" Click="GpuRemove_Click"/>
                                                <Button DockPanel.Dock="Right" Content="AMD" Tag="{Binding}" Padding="10,4" Margin="6,0,0,0" Click="GpuAmd_Click"/>
                                                <Button DockPanel.Dock="Right" Content="Intel" Tag="{Binding}" Padding="10,4" Margin="6,0,0,0" Click="GpuIntel_Click"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding ModeText}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding ExePath}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="GpuEmpty" Style="{StaticResource Muted}" Text="Chưa có ứng dụng."/>
                        </StackPanel>
                    </Border>

                    <!-- Top CPU processes -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Tiến trình ngốn CPU"/>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Ứng dụng" Style="{StaticResource Muted}"/>
                                <TextBlock Grid.Column="1" Text="CPU" Style="{StaticResource Muted}" TextAlignment="Right"/>
                                <TextBlock Grid.Column="2" Text="RAM" Style="{StaticResource Muted}" TextAlignment="Right"/>
                            </Grid>
                            <ItemsControl x:Name="ProcList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,6.5">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="85"/><ColumnDefinition Width="105"/><ColumnDefinition Width="80"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="Medium"/>
                                                <TextBlock Grid.Column="1" Text="{Binding CpuPercent, StringFormat={}{0:0.0}%}" TextAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                <TextBlock Grid.Column="2" Text="{Binding MemoryMB, StringFormat={}{0:0} MB}" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
                                                <Button Grid.Column="3" Style="{StaticResource Danger}" Content="Kết thúc" Tag="{Binding Pid}" HorizontalAlignment="Right" Margin="0" Click="Kill_Click"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Automation ===== -->
                <StackPanel x:Name="PageAuto" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Tự động hóa"/>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                        <!-- Plug / unplug -->
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <CheckBox x:Name="ChkAutoPower" Style="{StaticResource Switch}" Click="AutoSetting_Changed">
                                    <TextBlock Text="🔌  Đổi chế độ theo Sạc / Pin" FontSize="14.5" FontWeight="SemiBold"/>
                                </CheckBox>
                                <Grid Margin="0,14,0,0">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Cắm sạc" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                    <ComboBox Grid.Column="1" x:Name="CbAcProfile" SelectionChanged="AutoSetting_Changed" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Text="Chạy pin" VerticalAlignment="Center" Style="{StaticResource Muted}"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" x:Name="CbDcProfile" SelectionChanged="AutoSetting_Changed" Margin="0,3"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Battery alerts -->
                        <Border Grid.Column="1" Style="{StaticResource CardBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardTitle}" Text="🔔  Nhắc mức pin"/>
                                <CheckBox x:Name="ChkChargeAlert" Style="{StaticResource Switch}" Click="AutoSetting_Changed">
                                    <TextBlock Text="Báo đầy pin" FontWeight="Medium"/>
                                </CheckBox>
                                <DockPanel Margin="0,6,0,10">
                                    <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                               Text="{Binding Value, ElementName=SlChargeAlert, StringFormat={}{0:0}%}"/>
                                    <Slider x:Name="SlChargeAlert" Minimum="50" Maximum="100" ValueChanged="AutoSlider_Changed"/>
                                </DockPanel>
                                <CheckBox x:Name="ChkLowAlert" Style="{StaticResource Switch}" Click="AutoSetting_Changed">
                                    <TextBlock Text="Báo pin yếu" FontWeight="Medium"/>
                                </CheckBox>
                                <DockPanel Margin="0,6,0,0">
                                    <TextBlock DockPanel.Dock="Right" Width="42" TextAlignment="Right" FontWeight="SemiBold" Foreground="{StaticResource Accent}"
                                               Text="{Binding Value, ElementName=SlLowAlert, StringFormat={}{0:0}%}"/>
                                    <Slider x:Name="SlLowAlert" Minimum="5" Maximum="50" ValueChanged="AutoSlider_Changed"/>
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Per app -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <CheckBox x:Name="ChkAppRules" Style="{StaticResource Switch}" Click="AutoSetting_Changed">
                                <TextBlock Text="🎮  Quy tắc theo ứng dụng" FontSize="14.5" FontWeight="SemiBold"/>
                            </CheckBox>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="155"/><ColumnDefinition Width="165"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <ComboBox x:Name="CbRuleApp" IsEditable="True" Margin="0,0,8,0" ToolTip="Chọn hoặc nhập tên tiến trình"/>
                                <ComboBox Grid.Column="1" x:Name="CbRuleProfile" Margin="0,0,8,0"/>
                                <ComboBox Grid.Column="2" x:Name="CbRuleFan" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Style="{StaticResource Primary}" Content="+ Thêm" Margin="0" Click="AddRule_Click"/>
                            </Grid>
                            <ItemsControl x:Name="RuleList" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Danger}" Content="Xóa" Tag="{Binding}" Margin="8,0,0,0" Click="RemoveRule_Click"/>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Process}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="RuleEmpty" Style="{StaticResource Muted}" Text="Chưa có quy tắc." Margin="0,6,0,0"/>
                            <TextBlock x:Name="RuleStatus" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Cleanup & Disk Care ===== -->
                <StackPanel x:Name="PageClean" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Đĩa &amp; Dọn dẹp"/>

                    <!-- Boot Camp 100% Disk Optimizer -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border x:Name="BootOptBadge" CornerRadius="10" Padding="10,5" Margin="0,0,8,0" Background="{StaticResource OrangeSoft}">
                                        <TextBlock x:Name="BootOptBadgeText" Text="Đang kiểm tra…" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Orange}"/>
                                    </Border>
                                    <Button x:Name="BtnBootOptAll" ToolTip="Giảm nghẽn ổ SSD Apple ngay sau khi bật máy" Style="{StaticResource Primary}" Content="⚡ Tối ưu tất cả" Padding="13,6" Margin="0" Click="BootOptAll_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="🚀  Chống 100% Disk lúc khởi động" FontSize="15" FontWeight="SemiBold"/>
                                </StackPanel>
                            </DockPanel>

                            <UniformGrid Columns="3" Margin="-4,0">
                                <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="4,0">
                                    <CheckBox x:Name="ChkOptSysMain" ToolTip="Chặn nạp dồn 4–5 GB lúc mở máy" Style="{StaticResource Switch}" Click="BootOptToggle_Click" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="Tắt SysMain" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="4,0">
                                    <CheckBox x:Name="ChkOptSearch" ToolTip="Hoãn 2 phút · bỏ quét code/cache" Style="{StaticResource Switch}" Click="BootOptToggle_Click" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="Giảm quét Search" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <Border Background="{StaticResource SubtleBg}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="12,10" Margin="4,0">
                                    <CheckBox x:Name="ChkOptUpdaters" ToolTip="Tắt tự chạy OneDrive, Office, Apple" Style="{StaticResource Switch}" Click="BootOptToggle_Click" VerticalAlignment="Center">
                                        <StackPanel>
                                            <TextBlock Text="Hoãn cập nhật" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </UniformGrid>

                            <TextBlock x:Name="BootOptStatus" Style="{StaticResource Muted}" Margin="2,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>

                        <!-- Junk -->
                        <Border Style="{StaticResource CardBox}">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" x:Name="BtnScan" Style="{StaticResource Primary}" Content="Quét rác" Margin="0" Click="Scan_Click"/>
                                    <StackPanel>
                                        <TextBlock Text="Dung lượng rác" Style="{StaticResource Muted}"/>
                                        <TextBlock x:Name="CleanTotal" Style="{StaticResource Metric}" Text="—"/>
                                    </StackPanel>
                                </DockPanel>
                                <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,12"/>
                                <CheckBox x:Name="ChkCleanTemp" Style="{StaticResource Switch}" IsChecked="True" Margin="0,3" Click="CleanSelection_Changed">
                                    <DockPanel>
                                        <TextBlock x:Name="CleanTempSize" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="File tạm (Temp)" FontWeight="Medium"/>
                                    </DockPanel>
                                </CheckBox>
                                <CheckBox x:Name="ChkCleanBin" Style="{StaticResource Switch}" Margin="0,8,0,0" Click="CleanSelection_Changed">
                                    <DockPanel>
                                        <TextBlock x:Name="CleanBinSize" DockPanel.Dock="Right" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Thùng rác" FontWeight="Medium"/>
                                    </DockPanel>
                                </CheckBox>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnClean" Style="{StaticResource Primary}" Content="Dọn ngay" IsEnabled="False" Click="Clean_Click"/>
                                    <Button Content="Disk Cleanup…" Click="DiskCleanup_Click"/>
                                </StackPanel>
                                <TextBlock x:Name="CleanStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- RAM & SSD -->
                        <StackPanel Grid.Column="1">
                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" x:Name="BtnFreeRam" Style="{StaticResource Primary}" Content="Giải phóng" Padding="12,6" Margin="0" Click="FreeRam_Click"/>
                                        <StackPanel>
                                            <TextBlock Text="Bộ nhớ RAM" FontWeight="SemiBold" FontSize="14.5"/>
                                            <TextBlock x:Name="RamText" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ProgressBar x:Name="RamBar" Height="7" Maximum="100" Margin="0,10,0,0"/>
                                    <TextBlock x:Name="RamStatus" Style="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBox}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource CardTitle}" Text="Ổ cứng SSD" Margin="0,0,0,6"/>
                                    <ItemsControl x:Name="DriveList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
                                                    <UniformGrid Columns="4">
                                                        <StackPanel><TextBlock Text="Tuổi thọ" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Life}" FontSize="17" FontWeight="Bold" Foreground="{Binding LifeBrush}"/></StackPanel>
                                                        <StackPanel><TextBlock Text="Nhiệt" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Temp}" FontSize="17" FontWeight="Bold"/></StackPanel>
                                                        <StackPanel><TextBlock Text="Đã ghi" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Written}" FontSize="17" FontWeight="Bold"/></StackPanel>
                                                        <StackPanel><TextBlock Text="Đã dùng" Style="{StaticResource Muted}"/><TextBlock Text="{Binding Used}" FontSize="17" FontWeight="Bold"/></StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock x:Name="DriveEmpty" Style="{StaticResource Muted}" Text="Không có thông số SMART."/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>

                    <!-- Startup apps (compact) -->
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,6">
                                <Button x:Name="BtnStartupMore" DockPanel.Dock="Right" Padding="11,5" FontSize="12" Margin="0" Visibility="Collapsed" Click="StartupMore_Click"/>
                                <TextBlock x:Name="StartupCount" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock Style="{StaticResource CardTitle}" Text="🚀  Khởi động cùng Windows" Margin="0" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="StartupList">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,5" Margin="0,0,22,0">
                                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding Enabled, Mode=OneWay}" Tag="{Binding}"
                                                      ToolTip="{Binding Command}" Click="StartupToggle_Click">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis"/>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Settings ===== -->
                <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="Cài đặt"/>
                    <Border Style="{StaticResource CardBox}">
                        <StackPanel>
                            <DockPanel Margin="0,4">
                                <Border DockPanel.Dock="Right" Background="{StaticResource Bg}" CornerRadius="10" Padding="2">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="RbLangVi" Style="{StaticResource Seg}" GroupName="lang" Content="Tiếng Việt" Click="Lang_Click"/>
                                        <RadioButton x:Name="RbLangEn" Style="{StaticResource Seg}" GroupName="lang" Content="English" Click="Lang_Click"/>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Ngôn ngữ" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </DockPanel>
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,13"/>
                            <CheckBox x:Name="ChkStartup" Style="{StaticResource Switch}" Margin="0,4" Click="ChkStartup_Click">
                                <TextBlock Text="Khởi động cùng Windows" FontWeight="SemiBold"/>
                            </CheckBox>
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,13"/>
                            <CheckBox x:Name="ChkTray" Style="{StaticResource Switch}" Margin="0,4" IsChecked="True" Click="SettingsToggle_Click">
                                <TextBlock Text="Thu nhỏ xuống khay khi đóng" FontWeight="SemiBold"/>
                            </CheckBox>
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,13"/>
                            <CheckBox x:Name="ChkTrayTemp" Style="{StaticResource Switch}" Margin="0,4" IsChecked="True" Click="SettingsToggle_Click">
                                <TextBlock Text="Hiện nhiệt độ trên icon khay" FontWeight="SemiBold"/>
                            </CheckBox>
                            <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,13"/>
                            <CheckBox x:Name="ChkTop" Style="{StaticResource Switch}" Margin="0,4" Click="ChkTop_Click">
                                <TextBlock Text="Luôn nằm trên cùng" FontWeight="SemiBold"/>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBox}">
                        <DockPanel>
                            <TextBlock x:Name="AboutVersion" DockPanel.Dock="Right" Text="v1.0.0" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="Phiên bản" FontWeight="SemiBold"/>
                                <TextBlock Text="MacTune · Mã nguồn mở (GPL-3.0)" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock x:Name="SettingsStatus" Style="{StaticResource Muted}" Margin="6,8,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Floating Toast -->
        <Border x:Name="Toast" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,22"
                Background="#0F172A" CornerRadius="20" Padding="18,9" Visibility="Collapsed" Effect="{StaticResource PopupShadow}">
            <TextBlock x:Name="ToastText" Foreground="White" FontSize="13" FontWeight="Medium"/>
        </Border>
    </Grid>
</Window>
