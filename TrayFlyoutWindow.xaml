<Window x:Class="MacTune.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MacTune Control Center" Width="368" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <!-- Control Center Toggle Tile -->
        <Style x:Key="CcTile" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="b" CornerRadius="12" Padding="8,9" Background="#F3F7FD"
                                BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EBF3FE"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Control Center Radio Pill -->
        <Style x:Key="CcRadio" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" CornerRadius="9" Padding="6,7" Margin="2" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#EBF3FE"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14" CornerRadius="20" Background="#FCFDFF" BorderBrush="#D8E4F3" BorderThickness="1"
            Padding="15,14" Effect="{StaticResource PopupShadow}">
        <StackPanel>
            <!-- Top Header -->
            <DockPanel Margin="2,0,2,10">
                <Button DockPanel.Dock="Right" Content="Mở rộng ⤢" Padding="11,5" Margin="0" FontSize="12"
                        Background="{StaticResource AccentSoft}" Foreground="{StaticResource Accent}" Click="OpenMain_Click"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Margin="0,0,9,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#0A84FF" Offset="0"/>
                                <GradientStop Color="#0055D4" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MacTune" FontWeight="Bold" FontSize="14.5"/>
                        <TextBlock x:Name="FlySummary" Text="CPU – · Pin –" Style="{StaticResource Muted}" FontSize="11.5"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>

            <!-- Live Power In / Power Out Strip -->
            <UniformGrid Columns="2" Margin="-3,0,-3,8">
                <Border Background="{StaticResource GreenSoft}" BorderBrush="#C5EEDB" BorderThickness="1" CornerRadius="12" Padding="11,7" Margin="3,0">
                    <DockPanel>
                        <TextBlock x:Name="FlyPowerIn" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Green}" Text="–"/>
                        <TextBlock Text="🔌 Sạc vào" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource AccentSoft}" BorderBrush="#CBE0FC" BorderThickness="1" CornerRadius="12" Padding="11,7" Margin="3,0">
                    <DockPanel>
                        <TextBlock x:Name="FlyPowerOut" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13.5" Foreground="{StaticResource Accent}" Text="–"/>
                        <TextBlock Text="⚡ Đang dùng" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- Power Profiles -->
            <Border Background="#F3F7FC" CornerRadius="13" Padding="3" Margin="0,0,0,9">
                <UniformGrid Columns="3">
                    <RadioButton x:Name="FlyProfSilent" Style="{StaticResource CcRadio}" GroupName="flyprof" Tag="silent" Content="🍃 Yên lặng" Click="FlyProfile_Click"/>
                    <RadioButton x:Name="FlyProfBalanced" Style="{StaticResource CcRadio}" GroupName="flyprof" Tag="balanced" Content="⚖ Cân bằng" Click="FlyProfile_Click"/>
                    <RadioButton x:Name="FlyProfPerf" Style="{StaticResource CcRadio}" GroupName="flyprof" Tag="performance" Content="🚀 Hiệu năng" Click="FlyProfile_Click"/>
                </UniformGrid>
            </Border>

            <!-- Fan Control -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="11,9" Margin="0,0,0,9">
                <StackPanel>
                    <DockPanel Margin="2,0,2,5">
                        <TextBlock x:Name="FlyFanRpm" DockPanel.Dock="Right" Style="{StaticResource Muted}" FontSize="11.5" FontWeight="SemiBold"/>
                        <TextBlock Text="Quạt tản nhiệt" FontWeight="SemiBold" FontSize="12.5"/>
                    </DockPanel>
                    <Border x:Name="FlyFanBox" Background="#F3F7FC" CornerRadius="10" Padding="2">
                        <UniformGrid Columns="4">
                            <RadioButton x:Name="FlyFanAuto" Style="{StaticResource CcRadio}" GroupName="flyfan" Tag="auto" Content="Tự động" Click="FlyFan_Click"/>
                            <RadioButton x:Name="FlyFanQuiet" Style="{StaticResource CcRadio}" GroupName="flyfan" Tag="quiet" Content="Êm" Click="FlyFan_Click"/>
                            <RadioButton x:Name="FlyFanBal" Style="{StaticResource CcRadio}" GroupName="flyfan" Tag="balanced" Content="Cân bằng" Click="FlyFan_Click"/>
                            <RadioButton x:Name="FlyFanCool" Style="{StaticResource CcRadio}" GroupName="flyfan" Tag="cool" Content="Tối đa" Click="FlyFan_Click"/>
                        </UniformGrid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Sliders: Display & Keyboard Backlight -->
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="13,10" Margin="0,0,0,9">
                <StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock x:Name="FlyBrightVal" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE706;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13.5"
                                       Foreground="{StaticResource Orange}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Màn hình" FontWeight="SemiBold" FontSize="12.5"/>
                        </StackPanel>
                    </DockPanel>
                    <Slider x:Name="FlySlBright" Minimum="0" Maximum="100" ValueChanged="FlySlBright_ValueChanged"/>

                    <DockPanel Margin="0,9,0,4">
                        <TextBlock x:Name="FlyKbdVal" DockPanel.Dock="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold" FontSize="12"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE765;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13.5"
                                       Foreground="{StaticResource Accent}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="Đèn phím" FontWeight="SemiBold" FontSize="12.5"/>
                        </StackPanel>
                    </DockPanel>
                    <Slider x:Name="FlySlKbd" Minimum="0" Maximum="100" ValueChanged="FlySlKbd_ValueChanged"/>
                </StackPanel>
            </Border>

            <!-- 3 Quick Control Center Toggles -->
            <UniformGrid Columns="3" Margin="-3,0">
                <ToggleButton x:Name="BtnFlyMeeting" Style="{StaticResource CcTile}" Click="BtnFlyMeeting_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎤 Họp" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="Giữ sáng" FontSize="10.5" Opacity="0.78" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="BtnFlyMacKeys" Style="{StaticResource CcTile}" Click="BtnFlyMacKeys_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="⌘ Phím Mac" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock Text="⌘ ↔ Ctrl" FontSize="10.5" Opacity="0.78" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </ToggleButton>
                <ToggleButton x:Name="BtnFlyTbFn" Style="{StaticResource CcTile}" Click="BtnFlyTbFn_Click">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎛 F1–F12" FontWeight="SemiBold" FontSize="12" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="FlyTbSub" Text="Touch Bar" FontSize="10.5" Opacity="0.78" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    </StackPanel>
                </ToggleButton>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
